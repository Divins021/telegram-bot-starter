bot.start((ctx) => ctx.reply('Salut, je suis MELIODAS 1.0 ! /help pour voir les commandes.'));
bot.help((ctx) => ctx.reply('/taguer - tag tous les membres du groupe\n/ping - répondre pong'));

bot.command('taguer', async (ctx) => {
  if (ctx.chat.type === 'group' || ctx.chat.type === 'supergroup') {
    const members = await ctx.getChatAdministrators(); 
    let texte = '';
    members.forEach((m) => {
      if (m.user.username) {
        texte += `@${m.user.username} `;
      }
    });
    ctx.reply(texte || 'Pas de usernames trouvés.');
  } else {
    ctx.reply('Cette commande marche seulement en groupe.');
  }
});

bot.command('ping', (ctx) => {
  ctx.reply('pong');
});

bot.launch().then(() => {
  console.log('Telegram Bot prêt.');
});
```

